{
  "name": "@juanarenas31/metrik-ui",
  "version": "0.7.0",
  "description": "Librería de componentes React para dashboards analíticos · Unidad de Ciencia de los Datos · Universidad Simón Bolívar.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./charts": {
      "types": "./dist/charts.d.ts",
      "import": "./dist/charts.js"
    },
    "./table": {
      "types": "./dist/table.d.ts",
      "import": "./dist/table.js"
    },
    "./calendar": {
      "types": "./dist/calendar.d.ts",
      "import": "./dist/calendar.js"
    },
    "./command": {
      "types": "./dist/command.d.ts",
      "import": "./dist/command.js"
    },
    "./layout": {
      "types": "./dist/layout.d.ts",
      "import": "./dist/layout.js"
    },
    "./forms": {
      "types": "./dist/forms.d.ts",
      "import": "./dist/forms.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "import": "./dist/tailwind-preset.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "charts": [
        "./dist/charts.d.ts"
      ],
      "table": [
        "./dist/table.d.ts"
      ],
      "calendar": [
        "./dist/calendar.d.ts"
      ],
      "command": [
        "./dist/command.d.ts"
      ],
      "layout": [
        "./dist/layout.d.ts"
      ],
      "forms": [
        "./dist/forms.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src",
    "clean": "rm -rf dist",
    "size": "size-limit",
    "size:check": "size-limit && node scripts/check-core-isolation.mjs",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^8.21.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-day-picker": "^10.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "recharts": "^2.15.0",
    "tailwindcss": "^3.4.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    },
    "@tanstack/react-table": {
      "optional": true
    },
    "react-day-picker": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-checkbox": "^1.1.0",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@radix-ui/react-visually-hidden": "^1.2.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.456.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.0"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^12.1.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.28.1",
    "react": "^18.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.0",
    "recharts": "^2.15.4",
    "size-limit": "^12.1.0",
    "tailwindcss": "^3.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "tailwind",
    "design-system",
    "dashboard",
    "metrik",
    "unisimon"
  ],
  "author": "Unidad de Ciencia de los Datos · Universidad Simón Bolívar",
  "license": "MIT",
  "packageManager": "pnpm@11.3.0"
}
